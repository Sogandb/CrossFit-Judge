# Copy to .env  (cp .env.example .env) — read by docker compose
WEB_PORT=8080
WEB_BIND=0.0.0.0                 # use 127.0.0.1 when running behind the bundled Caddy / your own reverse proxy

# Protect the test site with a password (recommended on a public server)
ACCESS_USER=wodx
ACCESS_PASSWORD=change-me-now

# Engine tuning
JUDGE_WORKERS=1                  # parallel analyses; raise only if the server has spare CPU/RAM
JUDGE_EASE=0.5                   # 0 = strict rulebook ... 1 = very lenient (v2.1 default 0.5)
JUDGE_RETENTION_DAYS=30          # auto-delete videos + results after N days (0 = keep forever)
JUDGE_MAX_UPLOAD_BYTES=524288000 # 500 MB
JUDGE_USE_BEEP=0                 # 0 = the clock starts at the first video frame (Wodx protocol)
JUDGE_ANNOTATE=1                 # render the annotated review video

# Only for docker-compose.https.yml
# DOMAIN=judge.example.com
